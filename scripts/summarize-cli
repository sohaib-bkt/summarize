#!/usr/bin/env bash
#
# summarize-cli — Extrait et (pré-)résume le contenu d'une URL pour un agent.
#
# Ce script est un outil d'aide utilisé DANS le flux du skill "summarize".
# Il n'écrit pas le résumé final (c'est l'agent qui le rédige), il récupère
# juste le contenu brut et l'affiche, ou le stocke dans un fichier temporaire.
#
# Usage:
#   summarize <url>                 # affiche le contenu brut sur la sortie
#   summarize <url> -o FILE         # écrit le contenu brut dans FILE
#   summarize --fetch-only <url>    # identique à l'affichage brut
#
# Types supportés :
#   - YouTube  (via yt-dlp, sous-titres ar/fa/en ; fallback agent-reach)
#   - Web / Reddit / liens divers (via Jina Reader r.jina.ai)

set -euo pipefail

sbin() { command -v "$1" >/dev/null 2>&1; }

usage() {
  cat <<EOF
Usage: summarize <url> [-o FILE]

Récupère le contenu brut d'une URL (vidéo, page web, post…) et l'affiche,
ou l'enregistre dans un fichier avec -o.

Le résumé rédigé (essai) est produit par l'agent ; ce script ne fait que
la récupération de matière première.
EOF
}

URL=""
OUT=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -o) OUT="$2"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) URL="$1"; shift ;;
  esac
done

if [ -z "$URL" ]; then
  usage >&2
  exit 1
fi

# ---------------------------------------------------------------------------
# Détection du type de contenu
# ---------------------------------------------------------------------------
fetch_youtube() {
  local id
  # youtube.com/watch?v=ID / youtu.be/ID / shorts/ID
  id="$(echo "$URL" | sed -E 's#.*(?:watch\?v=|youtu\.be/|shorts/)([A-Za-z0-9_-]{11}).*#\1#')"
  if [ -z "$id" ]; then
    echo "Impossible de déterminer l'ID YouTube pour : $URL" >&2
    exit 1
  fi

  local tmpdir="/tmp"
  # Sous-titres arabes, sinon français, sinon anglais
  yt-dlp --write-sub --write-auto-sub \
         --sub-lang "ar,fa,en,fr" \
         --skip-download -o "$tmpdir/%(id)s" "$URL" \
         >/dev/null 2>&1 || true

  local vtt
  vtt="$(ls "$tmpdir/$id".*.vtt 2>/dev/null | head -1 || true)"
  if [ -n "$vtt" ]; then
    # Nettoyer les balises <c> et [timestamp] du .vtt
    sed -E 's/<[^>]+>//g; s/^[0-9:.]+ --> [0-9:.]+.*$//; /^$/d' "$vtt"
  else
    echo "# Pas de sous-titres disponibles pour cette vidéo." >&2
    echo "# Utilisez 'agent-reach transcribe <url>' pour une transcription audio." >&2
    echo "# Résumé possible seulement sur métadonnées :" >&2
    yt-dlp --print "%(title)s | %(duration_string)s | %(channel)s" "$URL" 2>/dev/null || true
  fi
}

fetch_web() {
  # Jina Reader : convertit une page web en texte propre
  curl -s "https://r.jina.ai/$URL"
}

# ---------------------------------------------------------------------------
# Routage
# ---------------------------------------------------------------------------
case "$URL" in
  *youtube.com/watch*|*youtu.be/*|*youtube.com/shorts/*)
    CONTENT="$(fetch_youtube)" ;;
  *)
    CONTENT="$(fetch_web)" ;;
esac

# ---------------------------------------------------------------------------
# Sortie
# ---------------------------------------------------------------------------
if [ -n "$OUT" ]; then
  echo "$CONTENT" > "$OUT"
  echo "Contenu brut écrit dans : $OUT" >&2
else
  echo "$CONTENT"
fi
